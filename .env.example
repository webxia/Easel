# ============================================================
# Easel 环境变量 — 标准 Anthropic API key
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# 模型（OpenClaw provider/model 格式）
CLAUDE_MODEL=anthropic/claude-sonnet-4-6

# 可选：Anthropic-compatible 服务
# EASEL_LLM_API_KEY=REPLACE_ME
# EASEL_LLM_BASE_URL=https://your-provider.example/v1
# EASEL_LLM_API_KEY_HEADER=api-key
# EASEL_LLM_ANTHROPIC_VERSION=2023-06-01

# OpenAI / OpenAI-compatible 服务
# OPENAI_API_KEY=REPLACE_ME
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# 可选：独立向量/Embedding API（不配置则使用关键词记忆检索，不请求聊天 API 的 embedding 模型）
# EASEL_EMBEDDING_API_KEY=REPLACE_ME
# EASEL_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# EASEL_EMBEDDING_MODEL=text-embedding-3-small

# OpenClaw gateway uses fixed port 18789 in the isolated profile; no OPENCLAW_PORT override is consumed.

# Hypit Runtime Profile：仅由 Easel 后端读取；文件必须符合当前 Hypit 的
# hypit.runtime-local@1 格式。Provider 凭证仍保存在 Hypit Credential Store，
# 不要把 API Key 写进 Runtime Profile 或交给浏览器。
# EASEL_HYPIT_RUNTIME_PROFILE=/absolute/path/to/hypit.runtime.json

# 小红书浏览器自动化默认关闭。disabled 时不会连接 BitBrowser 或其他浏览器。
# 仅在明确恢复后改为 playwright 或 bitbrowser；相关账号风险需自行确认。
XHS_BROWSER_BACKEND=disabled
# XHS_BITBROWSER_ACCOUNT=main
# BITBROWSER_API_URL=http://127.0.0.1:54345

# ============================================================
# 可选：媒体生成模型（也可在 Web「技能库」对应技能里填写）
# 只需配置实际使用的 provider；密钥留空不会启用。
# ============================================================

# 视频：dashscope / ark / kling / openai-compatible / xhs-maas / agnes
VIDEO_PROVIDER=
# AGNES_API_KEY=
# AGNES_MODEL=agnes-video-2.5-flash
# VIDEO_API_KEY=
# VIDEO_BASE_URL=
# VIDEO_MODEL=

# AI 音乐：dashscope / suno-compatible
MUSIC_PROVIDER=
# MUSIC_API_KEY=
# MUSIC_BASE_URL=
# MUSIC_MODEL=

# 云端 TTS：dashscope / minimax / fish-audio / openai-compatible / gemini
VOICE_PROVIDER=
# VOICE_API_KEY=
# VOICE_BASE_URL=
# VOICE_MODEL=
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# 多个媒体能力可复用同一份 DashScope key
# DASHSCOPE_API_KEY=

# Unified V1 video runtime/material configuration (all secrets stay local in .env).
# Easel reads process environment first, then these project-root .env entries.
# Hypit provider credentials remain in Hypit's own auth store; do not copy them here.
# EASEL_MATERIAL_LOCAL_ROOTS=/absolute/path/to/rights-documented-assets
# EASEL_MATERIAL_LIBRARY_ROOT=/absolute/path/to/material-library
# PEXELS_API_KEY=REPLACE_ME
# PIXABAY_API_KEY=REPLACE_ME
# COVERR_API_KEY=REPLACE_ME
# UNSPLASH_ACCESS_KEY=REPLACE_ME
# Preferred: OAuth client credentials allow in-memory access-token refresh.
# OPENVERSE_CLIENT_ID=REPLACE_ME
# OPENVERSE_CLIENT_SECRET=REPLACE_ME
# Compatibility fallback only; static tokens expire and must be replaced manually.
# OPENVERSE_ACCESS_TOKEN=REPLACE_ME
# Run `easel runtime dependencies` for the full inventory or
# `easel runtime readiness --profile core-video` for a secret-free status report.

# Optional question-bridge/runtime overrides consumed by current Easel code.
# EASEL_OPENCLAW_STATE_DIR=/absolute/path/to/isolated-openclaw-profile
# EASEL_GATEWAY_HOST=127.0.0.1
# EASEL_GATEWAY_PORT=18789
# These affect easel/gateway_questions.py only. `scripts/gateway.sh` keeps the
# isolated OpenClaw easel profile and the Gateway default loopback endpoint.
# HYPIT_BIN=/absolute/path/to/hypit
# ANTHROPIC_AUTH_TOKEN=REPLACE_ME
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_MAAS_API_KEY=REPLACE_ME
# OPENAI_MAAS_ENDPOINT=https://your-openai-compatible-endpoint/v1
# OPENAI_MAAS_MODEL=gpt-5.5
# OPENAI_MAAS_API_KEY_HEADER=Authorization
# OPENAI_MAAS_ADAPTER_PORT=18791

# Legacy standalone media scripts only; these do not configure Easel's formal
# Hypit Generation Gateway. Configure only when explicitly using the legacy Skills.
# See skills/shared/scripts/model_registry.py for the complete provider/alias catalogue.
# IMG_API_KEY=REPLACE_ME
# IMG_BASE_URL=https://your-image-provider.example/v1
# IMG_MODEL=
# IMG_API_KEY_HEADER=Authorization
# IMG_API_VERSION=
# IMG_NO_PROXY=1
# VIDEO_PROVIDER=ark
# VIDEO_API_KEY=REPLACE_ME
# VIDEO_BASE_URL=https://your-video-provider.example/v1
# VIDEO_MODEL=
# ARK_API_KEY=REPLACE_ME
# KLING_ACCESS_KEY=REPLACE_ME
# KLING_SECRET_KEY=REPLACE_ME
# XHS_MAAS_API_KEY=REPLACE_ME
# AGNES_API_KEY=REPLACE_ME
# VIDEO_CAPABILITIES_JSON={}
# VOICE_NARRATOR_VOICE_ID=
# Material Layer AI video generation (MiniMax; this provider is remote and may incur charges).
# Prefer a dedicated Easel key; MINIMAX_API_KEY remains a compatibility fallback for existing MiniMax setups.
# EASEL_MINIMAX_API_KEY=REPLACE_ME
# EASEL_MINIMAX_VIDEO_MODEL=MiniMax-H3-Max
# Material Layer AI generation (MiniMax image-01, Video H3, preset-voice TTS).
# Each generation call may incur provider charges and requires explicit authorization (a scoped commission budget or individual confirmation).
# EASEL_MINIMAX_BASE_URL=https://api.minimax.cn
# EASEL_MINIMAX_IMAGE_MODEL=image-01
# EASEL_MINIMAX_SPEECH_MODEL=speech-2.8-hd
# EASEL_MINIMAX_SPEECH_VOICE_ID=male-qn-qingse
# EASEL_MINIMAX_VIDEO_BASE_URL=https://api.minimax.cn  # legacy base-url alias
# FISH_API_KEY=REPLACE_ME
# MUSIC_PROVIDER=dashscope
# MUSIC_API_KEY=REPLACE_ME

# 本地旁白时序恢复：已有有效 TTS 时序时不使用；不自动下载模型。
# faster-whisper 本地目录，留空使用 ~/.cache/easel-models/faster-whisper-small。
# EASEL_ASR_MODEL=/absolute/path/to/local/faster-whisper-model
